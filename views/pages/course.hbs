<body>
<div class="bg-gray-100 font-sans">
    <div class="container mx-auto p-4">
        <div class="flex items-center justify-between mb-4">
            <h1 class="text-2xl font-bold">Courses</h1>
            <div class="flex items-center gap-4">
                <div>
                    <a href="/courses/add" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md">
                        Add New Course
                    </a>
                </div>
                <!-- Input Search -->
                <div class="relative">
                    <input
                        id="search"
                        type="text"
                        placeholder="Search courses..."
                        class="border border-gray-300 rounded-md py-2 pl-10 pr-4 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
                        🔍
                    </span>
                </div>
                <!-- Sort Dropdown -->
                <div>
                    <select 
                        id="sort"
                        class="border border-gray-300 rounded-md py-2 pl-3 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="Title_asc">Sort by Title (A-Z)</option>
                        <option value="Title_desc">Sort by Title (Z-A)</option>
                        <option value="Price_asc">Sort by Price (Low to High)</option>
                        <option value="Price_desc">Sort by Price (High to Low)</option>
                        <option value="Duration_asc">Sort by Duration (Shortest)</option>
                        <option value="Duration_desc">Sort by Duration (Longest)</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto course-container">
            <table class="min-w-full bg-white border border-gray-300">
                <thead>
                    <tr class="w-full bg-gray-200">
                        <th class="py-2 px-4 text-left">Title</th>
                        <th class="py-2 px-4 text-left">Duration</th>
                        <th class="py-2 px-4 text-left">Level</th>
                        <th class="py-2 px-4 text-left">Lecturer</th>
                        <th class="py-2 px-4 text-left">Price</th>
                        <th class="py-2 px-4 text-left">Rating</th>
                        <th class="py-2 px-4 text-left">Sale</th>
                        <th class="py-2 px-4 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each courses}}
                    <tr class="hover:bg-gray-100 border-t">
                        <td class="py-3 px-4">{{this.Title}}</td>
                        <td class="py-3 px-4">{{this.Duration}} hours</td>
                        <td class="py-3 px-4">{{this.Level}}</td>
                        <td class="py-3 px-4">{{this.Lecturer}}</td>
                        <td class="py-3 px-4">${{this.Price}}</td>
                        <td class="py-3 px-4">{{this.Rate}}/5</td>
                        <td class="py-3 px-4">{{this.Sale}}%</td>
                        <td class="py-3 px-4">
                            <a href="/courses/{{this._id}}" class="text-blue-600 hover:text-blue-800">
                                    👁️
                                </a>
                           
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between mt-4 text-gray-600 text-sm">
            <div class="paging">
                Showing {{startItem}}-{{endItem}} of {{totalItem}}
            </div>
            <div class="flex space-x-2">
                <button class="border rounded-md border-gray-300 px-3 py-1 hover:bg-gray-100 transition prev" onclick="changePage('prev')">
                    &lt;
                </button>
                <button class="border rounded-md border-gray-300 px-3 py-1 hover:bg-gray-100 transition next" onclick="changePage('next')">
                    &gt;
                </button>
            </div>
        </div>
    </div>
</div>
<script src="/javascripts/CourseScript.js"></script>
</body>
