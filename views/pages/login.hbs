<body class="bg-[#4f75ff] flex items-center justify-center min-h-screen mr-64">

  <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-sm">
    <h2 class="text-xl font-bold text-center text-gray-800">Login to Account</h2>
    <p class="text-sm text-center text-gray-600 mb-6">Please enter your email and password to continue</p>

    <form action="/" method="POST">
      <!-- Email Address -->
      <div class="mb-4">
        <label for="email" class="block text-sm font-medium text-gray-700">Email address</label>
        <input
          type="email"
          id="email"
          name="email"
          class="w-full mt-1 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-[#4f75ff] focus:border-[#4f75ff]"
          placeholder="yourname@example.com"
          required
        >
      </div>

      <!-- Password -->
      <div class="mb-4">
        <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
        <div class="relative">
          <input
            id="passwordInput"
            type="password"
            name="password"
            placeholder="Enter your Password"
            class="w-full px-4 py-2 border rounded mt-2 mb-4 text-base"
          />
          <button
            type="button"
            id="togglePassword"
            class="absolute inset-y-0 right-4 text-[#59595A]"
          >
          </button>
        </div>
      </div>

      <!-- Error Message -->
      {{#if errorMessage}}
      <div class="mb-4 text-red-500 text-sm text-center font-semibold">
        {{errorMessage}}
      </div>
      {{/if}}

      <!-- Submit Button -->
      <div>
        <button
          type="submit"
          class="w-full bg-blue-500 text-white py-2 px-4 rounded-md hover:bg-[#4f75ff] focus:outline-none focus:ring-2 focus:ring-[#4f75ff] focus:ring-offset-2"
        >
          Submit
        </button>
      </div>
    </form>
  </div>

</body>
</html>

<script>
const togglePassword = document.getElementById('togglePassword');
const passwordInput = document.getElementById('passwordInput');
const eyeIcon = document.getElementById('eyeIcon');


const togglePassword = document.getElementById('togglePassword');
const passwordInput = document.getElementById('passwordInput');
const eyeIcon = document.getElementById('eyeIcon');

togglePassword.addEventListener('click', () => {
  if (passwordInput.type === 'password') {
    passwordInput.type = 'text'; 
    eyeIcon.classList.remove('fa-eye-slash');
    eyeIcon.classList.add('fa-eye');
  } else {
    passwordInput.type = 'password'; 
    eyeIcon.classList.remove('fa-eye'); 
    eyeIcon.classList.add('fa-eye-slash');
  }
});

</script>
