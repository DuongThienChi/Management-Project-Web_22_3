<body>
<div class="bg-gray-100 font-sans">
    <div class="container mx-auto p-4">
        <div class="flex items-center justify-between mb-4">
            <h1 class="text-2xl font-bold">Users</h1>
            <div class="flex items-center gap-4">
                <!-- Input Search -->
                <div class="relative">
                    <input
                     id = "search"
                     type="text" placeholder="Search user name..." 
                        class="border border-gray-300 rounded-md py-2 pl-10 pr-4 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
                        🔍
                    </span>
                </div>
                <!-- Sort Dropdown -->
                <div>
                    <select 
                        id="sort"
                        class="border border-gray-300 rounded-md py-2 pl-3 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="name_asc">Sort by Name (A-Z)</option>
                        <option value="name_desc">Sort by Name (Z-A)</option>
                        <option value="created_asc">Sort by Date Created (Oldest)</option>
                        <option value="created_desc">Sort by Date Created (Newest)</option>
                    </select>
                </div>
    </div>
        </div>
        <div class="overflow-x-auto user-container">
            <table class="min-w-full bg-white border border-gray-300">
                <thead>
                    <tr class="w-full bg-gray-200">
                        <th class="py-2 px-4 text-left">Username</th>
                        <th class="py-2 px-4 text-left">Email</th>
                        <th class="py-2 px-4 text-left">Contact</th>
                        <th class="py-2 px-4 text-left">Address</th>
                        <th class="py-2 px-4 text-left">Verify</th>
                        <th class="py-2 px-4 text-left">Ban</th>
                        <th class="py-2 px-4 text-left">Create At</th>
                        <th class="py-2 px-4 text-left">Action</th>

                    </tr>
                </thead>
                <tbody>
                    {{#each users}}
                    <tr class="hover:bg-gray-100 border-t">
                        <td class="py-3 px-4">{{this.username}}</td>
                        <td class="py-3 px-4">{{this.email}}</td>
                        <td class="py-3 px-4">{{this.contact}}</td>
                        <td class="py-3 px-4">{{this.address}}</td>
                        <td class="py-3 px-4">{{formatBooleanToText this.verify}}</td>
                        <td class="py-3 px-4">{{formatBooleanToText this.ban}}</td>
                        <td class="py-3 px-4">{{formatDate this.createdAt}}</td>
                        <td class="py-3 px-4">
                            <div class="flex space-x-2 border rounded">
                                <a href="/users/view/{{this._id}}" class="text-blue-600 hover:text-blue-800">
                                    👁️
                                </a>
                                <span class="text-gray-400 h-full">|</span>
                                <a href="/users/ban/{{this._id}}" class="text-red-600 hover:text-red-800">
                                    🚫
                                </a> 
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between mt-4 text-gray-600 text-sm">
            <div class = "paging">
                Showing {{startItem}}-{{endItem}} of {{totalItem}}
            </div>
        <div class="flex space-x-2">
            <button class="border rounded-md border-gray-300 px-3 py-1 hover:bg-gray-100 transition prev" onclick="changePage('prev')">
                &lt;
            </button>
            <button class="border rounded-md border-gray-300 px-3 py-1 hover:bg-gray-100 transition next" onclick="changePage('next')">
                &gt;
            </button>
        </div>
</div>
    </div>
</div>
    <script src="/javascript/userScript.js"></script>
</body>