<div class="flex items-center justify-center">
  <div class="bg-white w-full max-w-full max-h-full">
    <form id="courseForm" method="POST">
      <!-- Course Image -->
      <div class="flex items-center justify-center mb-6">
        <img id="courseImagePreview" src="https://via.placeholder.com/80" alt="Course Image" class="rounded-lg w-32 h-32 object-cover">
        <input type="file" id="courseImage" name="Img" accept="image/*" class="hidden" onchange="previewImage(event)">
       
      </div>

      <!-- Title -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Title</label>
        <input type="text" id="title" name="Title" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Title}}">
      </div>

      <!-- Duration -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Duration (Weeks)</label>
        <input type="number" id="duration" name="Duration" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Duration}}">
      </div>

      <!-- Level -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Level</label>
        <select id="level" name="Level" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]">
          <option value="Beginner" {{#if (eq Course.Level 'Beginner')}}selected{{/if}}>Beginner</option>
          <option value="Intermediate" {{#if (eq Course.Level 'Intermediate')}}selected{{/if}}>Intermediate</option>
          <option value="Advanced" {{#if (eq Course.Level 'Advanced')}}selected{{/if}}>Advanced</option>
        </select>
      </div>

      <!-- Description -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Description</label>
        <textarea id="description" name="Description" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]">{{Course.Description}}</textarea>
      </div>

      <!-- Price -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Price ($)</label>
        <input type="number" id="price" name="Price" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Price}}">
      </div>

      <!-- Buttons -->
      <div class="flex justify-between">
        <button type="button" class="px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400" onclick="cancelEdit()">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-[#4f75ff] text-white rounded-lg">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  function cancelEdit() {
    window.location.href = '/courses'; // Redirect to the courses list page
  }

  function previewImage(event) {
    const reader = new FileReader();
    reader.onload = function () {
      const output = document.getElementById('courseImagePreview');
      output.src = reader.result;
    };
    reader.readAsDataURL(event.target.files[0]);
  }

  document.addEventListener('DOMContentLoaded', function () {
  document.getElementById('courseForm').addEventListener('submit', async function (event) {
    event.preventDefault();

    alert('Save button clicked! Form is being submitted.');

    const path = window.location.pathname;
    const pathSegments = path.split('/');
    const courseId = pathSegments.length > 2 ? pathSegments[2] : null;

    if (!courseId) {
      alert('Error: Course ID not found in URL!');
      console.error('Course ID not found in URL:', path);
      return;
    }

    const formData = {
      CourseID: courseId,
      Title: document.getElementById('title').value,
      Duration: document.getElementById('duration').value,
      Level: document.getElementById('level').value,
      Description: document.getElementById('description').value,
      Price: document.getElementById('price').value,
    };

    try {
      const response = await fetch(`/courses/edit/update`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData),
      });

      const result = await response.json();

      if (result.success) {
        alert('Course updated successfully!');
        window.location.href = '/courses';
      } else {
        alert('Error updating course: ' + result.message);
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An unexpected error occurred.');
    }
  });
});


</script>
