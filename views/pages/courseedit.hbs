<div class="flex items-center justify-center">
  <div class="bg-white w-full max-w-full max-h-full">
    <form id="courseForm" method="POST">
      <!-- Course Image -->
      <div class="flex items-center justify-center mb-6">
        <div class="relative inline-block group">
          <label for="Image" class="cursor-pointer">
            <img src="{{getThumbnail Course.Img}}" alt="Upload Image" class="rounded-full w-20 h-20 object-cover border border-gray-300">
            <!-- Icon overlay -->
            <div class="absolute rounded-full w-20 h-20 inset-0 bg-black bg-opacity-50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <!-- Font Awesome Edit Icon -->
              <i class="fas fa-edit text-white text-2xl"></i>
            </div>
          </label>
          <input type="file" id="Image" name="Image" class="hidden" accept="image/*">

        </div>
      </div>
     

      <!-- Title -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Title</label>
        <input type="text" id="title" name="Title" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Title}}">
        <span id="titleError" class="text-red-500 text-sm hidden">Please enter a valid title.</span>
      </div>

      <!-- Duration -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Duration (Weeks)</label>
        <input type="number" id="duration" name="Duration" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Duration}}">
        <span id="durationError" class="text-red-500 text-sm hidden">Please enter a valid duration (positive number).</span>
      </div>

      <!-- Level -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Level</label>
        <select id="level" name="Level" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]">
          <option value="Beginner" {{#if (eq Course.Level 'Beginner')}}selected{{/if}}>Beginner</option>
          <option value="Intermediate" {{#if (eq Course.Level 'Intermediate')}}selected{{/if}}>Intermediate</option>
          <option value="Advanced" {{#if (eq Course.Level 'Advanced')}}selected{{/if}}>Advanced</option>
        </select>
         <span id="levelError" class="text-red-500 text-sm hidden">Please select a valid level.</span>
      </div>

      <!-- Description -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Description</label>
        <textarea id="description" name="Description" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]">{{Course.Description}}</textarea>
        <span id="descError" class="text-red-500 text-sm hidden">Please enter a valid description.</span>
      </div>

      <!-- Price -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Price ($)</label>
        <input type="number" id="price" name="Price" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Price}}">
        <span id="priceError" class="text-red-500 text-sm hidden">Please enter a valid price.</span>

      </div>

      <!-- Sale -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Sale (%)</label>
        <input type="number" id="sale" name="Sale" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Sale}}">
        <span id="saleError" class="text-red-500 text-sm hidden">Please enter a valid price.</span>

      </div>

      <!-- Rating -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Rating</label>
        <input type="number" step="0.1" id="rating" name="Rate" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Rate}}">
        <span id="ratingError" class="text-red-500 text-sm hidden">Please enter a valid rating (0-5).</span>
      </div>

      <!-- Lecturer -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Lecturer</label>
        <input type="text" id="lecturer" name="Lecturer" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{Course.Lecturer}}">
        <span id="lecturerError" class="text-red-500 text-sm hidden">Please enter a valid lecture.</span>
      </div>

      <!-- Buttons -->
      <div class="flex justify-between">
        <button type="button" class="px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400" onclick="cancelEdit()">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-[#4f75ff] text-white rounded-lg">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
  document.getElementById('courseForm').addEventListener('submit', async function (event) {
    event.preventDefault();

    // Clear previous error messages
    clearErrors();

    let valid = true;

    // Validate Title
    const title = document.getElementById('title').value;
    if (!title) {
      document.getElementById('titleError').classList.remove('hidden');
      valid = false;
    }

    // Validate Duration (positive number)
    const duration = document.getElementById('duration').value;
    if (isNaN(duration) || duration <= 0) {
      document.getElementById('durationError').classList.remove('hidden');
      valid = false;
    }

    // Validate Price (positive number)
    const price = document.getElementById('price').value;
    if (isNaN(price) || price < 0) {
      document.getElementById('priceError').classList.remove('hidden');
      valid = false;
    }

    // Validate Sale (0-100)
    const sale = document.getElementById('sale').value;
    if (isNaN(sale) || sale < 0 || sale > 100) {
      document.getElementById('saleError').classList.remove('hidden');
      valid = false;
    }

    // Validate Rating (0-5)
    const rating = document.getElementById('rating').value;
    if (isNaN(rating) || rating < 0 || rating > 5) {
      document.getElementById('ratingError').classList.remove('hidden');
      valid = false;
    }

    if (!valid) {
      return; // Stop form submission if validation failed
    }

    // Process form data if all fields are valid
   const formData = new FormData();
    const path = window.location.pathname;
    const pathSegments = path.split('/');
    const courseId = pathSegments.length > 2 ? pathSegments[2] : null;

    formData.append('CourseID', courseId);
    formData.append('Title', document.getElementById('title').value);
    formData.append('Duration', document.getElementById('duration').value);
    formData.append('Level', document.getElementById('level').value);
    formData.append('Description', document.getElementById('description').value);
    formData.append('Price', document.getElementById('price').value);
    formData.append('Sale', document.getElementById('sale').value);
    formData.append('Rate', document.getElementById('rating').value);
    formData.append('Lecturer', document.getElementById('lecturer').value);

    // Append the image file, if selected
    const imageFile = document.getElementById('Image').files[0];
    if (imageFile) {
        formData.append('Image', imageFile);
    }

    try {
        const response = await fetch('/courses/edit/update', {
            method: 'POST',
            body: formData,
        });

        const result = await response.json();

        if (result.success) {
            window.location.href = '/courses';
        } else {
            console.error(result.message);
        }
    } catch (error) {
      console.error('Error:', error);
    }
  });
});

// Function to clear error messages
function clearErrors() {
  const errorMessages = document.querySelectorAll('.text-red-500');
  errorMessages.forEach(error => {
    error.classList.add('hidden');
  });
}
function cancelEdit() {
  window.location.href = '/courses'; 
}
document.getElementById('Image').addEventListener('change', function (event) {
    const file = event.target.files[0];

    if (file) {
        // Hiển thị ảnh đã chọn trong trình duyệt trước khi upload
        const reader = new FileReader();
        reader.onload = function (e) {
            document.querySelector('label img').src = e.target.result;
        };
        reader.readAsDataURL(file);
    }
});
document.querySelector('label img').src = result.imagePath + '?t=' + new Date().getTime();


</script>



