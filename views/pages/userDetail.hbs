<div class="flex items-center justify-center">
  <div class="bg-white w-full max-w-full max-h-full">
          <!-- Profile Picture -->
      <div class="flex items-center justify-center mb-6">
        <img src="https://via.placeholder.com/80" alt="Profile" class="rounded-full w-20 h-20">
      </div>

      <!-- Name -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Name</label>
        <div class="flex items-center">
          <input readonly type="text" id="name" name="name" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{userDetail.name}}" disabled>
        </div>
      </div>

      <!-- Email -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Email</label>
        <div class="flex items-center">
          <input  readonly type="email" id="email" name="email" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{userDetail.email}}" disabled>
        </div>
      </div>

      <!-- Address -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Address</label>
        <div class="flex items-center">
          <input readonly type="text" id="address" name="address" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{userDetail.address}}" disabled>
        </div>
      </div>

      <!-- Contact -->
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Contact</label>
        <div class="flex items-center">
          <input readonly type="text" id="contact" name="contact" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{userDetail.contact}}" disabled>
        </div>
      </div>
      <div class="mb-6 relative">
        <label class="block text-sm font-medium text-gray-700">Create At</label>
        <div class="flex items-center">
          <input readonly type="text" id="createAt" name="createAt" class="w-full mt-1 p-2 border border-gray-300 rounded-lg focus:ring-[#4f75ff] focus:border-[#4f75ff]" value="{{userDetail.createdAt}}" disabled>
        </div>
      <!-- Buttons -->
      <div class="flex justify-between mt-6">
        <button type="button" class="px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400" onclick="cancelEdit()">Back</button>
      </div>
  </div>
</div>
<script>
  function cancelEdit() {
    window.location.href = '/users';
  }
</script>
